# Where the Express API runs. Used only by the Next.js server for the /api rewrite.
BACKEND_URL=http://localhost:4000

# Hosts other than localhost that may open the dev server (e.g. a dev tunnel). Comma-separated, optional.
ALLOWED_DEV_ORIGINS=

# JournL integration screens (JournL Books, corrections, connection code, JournL access). Off by default.
# Keep in step with the backend's JOURNL_INTEGRATION_ENABLED. Restart `next dev` after changing it.
NEXT_PUBLIC_JOURNL_INTEGRATION=false
